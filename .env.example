# =============================================================================
# Realty Marketplace — environment variable template
#
# HOW TO USE THIS FILE
#   1. Copy it:  cp .env.example .env.local
#   2. Fill in the real values from your Supabase dashboard.
#   3. Never commit .env.local — .gitignore already blocks it.
#
# This template IS committed on purpose: it documents which variables the
# project needs, without containing a single real secret.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase  →  dashboard.supabase.com → your project → Project Settings → API
# -----------------------------------------------------------------------------

# The project's API endpoint. Looks like https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / "publishable" key.
# SAFE to expose in the browser — that is what it is designed for. It can only
# do what the Row Level Security policies allow.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The "service_role" / "secret" key.
# DANGEROUS. It bypasses every RLS policy and can read and modify all data for
# every user. Server-side only: webhook handlers and admin scripts.
# If this value is ever committed, pasted into a client component, or shared,
# treat it as compromised and rotate it immediately in the Supabase dashboard.
SUPABASE_SERVICE_ROLE_KEY=

# The direct Postgres connection string, used ONLY to run migrations from your
# machine (`npx supabase db push`). The app itself never uses it.
#   Dashboard → Project Settings → Database → Connection string → URI
#   Pick "Session pooler" and replace [YOUR-PASSWORD] with your database password.
# Contains your database password, so it is as sensitive as the service role key.
SUPABASE_DB_URL=

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

# The public base URL of this deployment. Used to build the links inside
# confirmation emails, which must point at the right place.
# Local development: http://localhost:3000
# Production:        https://your-project.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Added in later phases — listed here so the full picture is visible.
# Leave blank for Phase 1.
# -----------------------------------------------------------------------------

# Phase 2 — Paystack (listing fees, commission invoices)
# PAYSTACK_SECRET_KEY=
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Phase 2 — Cloudinary (listing photos)
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Phase 4 — Resend (booking and status emails)
# RESEND_API_KEY=

# Phase 7 — Sentry (error monitoring)
# NEXT_PUBLIC_SENTRY_DSN=
