# =============================================================================
# Realty Marketplace — environment variable template
#
# HOW TO USE THIS FILE
#   1. Copy it:  cp .env.example .env.local
#   2. Fill in the real values from your Supabase dashboard.
#   3. Never commit .env.local — .gitignore already blocks it.
#
# This template IS committed on purpose: it documents which variables the
# project needs, without containing a single real secret.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase  →  dashboard.supabase.com → your project → Project Settings → API
# -----------------------------------------------------------------------------

# The project's API endpoint. Looks like https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / "publishable" key.
# SAFE to expose in the browser — that is what it is designed for. It can only
# do what the Row Level Security policies allow.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The "service_role" / "secret" key.
# DANGEROUS. It bypasses every RLS policy and can read and modify all data for
# every user. Server-side only: webhook handlers and admin scripts.
# If this value is ever committed, pasted into a client component, or shared,
# treat it as compromised and rotate it immediately in the Supabase dashboard.
SUPABASE_SERVICE_ROLE_KEY=

# The direct Postgres connection string, used ONLY to run migrations from your
# machine (`npx supabase db push`). The app itself never uses it.
#   Dashboard → Project Settings → Database → Connection string → URI
#   Pick "Session pooler" and replace [YOUR-PASSWORD] with your database password.
# Contains your database password, so it is as sensitive as the service role key.
SUPABASE_DB_URL=

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

# The public base URL of this deployment. Used to build the links inside
# confirmation emails, which must point at the right place.
# Local development: http://localhost:3000
# Production:        https://your-project.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Added in later phases — listed here so the full picture is visible.
#
# These are left UNCOMMENTED with empty values on purpose. An earlier version
# commented them out, and filling in a value while leaving the leading `#` in
# place produced a variable that looked present but was invisible to the app —
# a genuinely confusing thing to debug. An empty variable is harmless; a
# commented one that looks filled in is not.
# -----------------------------------------------------------------------------

# Phase 2 — Cloudinary (listing photos).
# Dashboard → Product Environment Credentials. The cloud name is public (it
# appears in every image URL); the secret is not, hence no NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Phase 2 — Paystack (listing fees, commission invoices).
# Use TEST keys (sk_test_… / pk_test_…) during development — live keys move
# real money and need business verification.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Phase 2 — Resend (listing approval, rejection and fee emails). Also worth
# setting as custom SMTP in Supabase Auth, whose built-in sender caps at a few
# messages an hour.
RESEND_API_KEY=

# Who those emails come FROM. Resend only delivers from a domain you have
# verified with it. Leave this blank until a real domain exists and Resend's
# sandbox sender is used instead — but note the sandbox only delivers to the
# address that owns the Resend account, so a landlord would never receive one.
#   Example once a domain is verified:  Realty Marketplace <hello@yourdomain.ng>
EMAIL_FROM=

# Phase 2 — the shared secret protecting /api/billing/run, the daily endpoint
# that charges saved cards for the monthly listing fee. Anyone who could call it
# could hammer Paystack with attempts against real customers' cards.
#
# Generate a long random one and never reuse it anywhere else:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# On Vercel, set this as an environment variable on the project and Vercel Cron
# sends it automatically as `Authorization: Bearer <value>` — no other wiring.
CRON_SECRET=

# Phase 7 — Sentry (error monitoring)
NEXT_PUBLIC_SENTRY_DSN=

# Optional — contact string sent to OpenStreetMap's geocoder in the User-Agent.
# Defaults to NEXT_PUBLIC_SITE_URL. Set once a real domain exists.
NOMINATIM_CONTACT=
